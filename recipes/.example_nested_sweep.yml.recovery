
schema_version: 1
name: semantic-editor
root:
  id: root
  type: sequence
  children:
    - id: source-sweep
      type: sweep
      target: keithley.B.current
      start: "0 A"
      stop: "1 mA"
      points: 2
      children:
        - id: settle
          type: wait
          duration: "10 ms"
